  "_comment": "Curriculum shape rules + per-track lexical spine. Read by scripts/validate-curriculum.mjs.",
  "rungs": {
    "1": {
      "name": "Word",
      "minTokens": 1,
      "maxTokens": 1,
      "minCarryOver": 0,
      "newLexemeBudget": 8
